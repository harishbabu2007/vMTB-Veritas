{
  "name": "transcript-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Post-meeting transcript worker: claims a completed meeting from Supabase, uploads transcript artifacts to GCS, generates AI minutes-of-meeting and marks the meeting COMPLETED. Triggered by a Pub/Sub push subscription.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:pull": "tsx scripts/local-pull-push.ts"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.9.0",
    "@google-cloud/storage": "^7.14.0",
    "@supabase/supabase-js": "^2.47.10",
    "dotenv": "^16.4.7",
    "google-auth-library": "^11.1.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
