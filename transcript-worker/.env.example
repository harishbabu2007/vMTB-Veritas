# transcript-worker configuration
# Copy to .env and fill in values. Never commit real secrets.

# --- Server ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# --- Supabase (status transitions + segment reads) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- GCS artifacts ---
GCS_BUCKET=YOUR-TRANSCRIPT-BUCKET
GCP_PROJECT_ID=YOUR-GCP-PROJECT-ID

# --- Pub/Sub push auth ---
# Must match the token configured on the push subscription. Empty = disabled (dev only).
PUBSUB_PUSH_TOKEN=

# --- LLM minutes-of-meeting (optional; no-op when unset) ---
# provider: "none" (skip MoM) or "vertex" (production; Vertex AI Chat
# Completions + cheapest stable Flash-Lite). Auth is Application Default
# Credentials (Cloud Run SA locally: `gcloud auth application-default login`).
# No LLM_API_KEY needed for vertex. GCP_PROJECT_ID must be set so the
# Vertex base URL can be built (or set LLM_BASE_URL yourself).
#
#   LLM_PROVIDER=vertex
#   GCP_PROJECT_ID=YOUR-GCP-PROJECT-ID
#   LLM_MODEL=google/gemini-3.1-flash-lite   # cheapest stable; google/ prefix required on Vertex
#
# Alternatives (swap LLM_BASE_URL/LLM_MODEL/LLM_API_KEY):
#   AI Studio Gemini: https://generativelanguage.googleapis.com/v1beta/openai  gemini-3.1-flash-lite  + LLM_API_KEY
#   Mistral:          https://api.mistral.ai/v1                               mistral-small-latest    + LLM_API_KEY
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# --- Automatic VM teardown (optional) ---
# After processing a completed meeting the worker POSTs {url}/stop-jitsi so an
# idle Jitsi VM never bills overnight (guarded by live-session heartbeats).
# Within a single delivery it re-checks live sessions and retries transient
# stop failures until VM_STOP_MAX_WAIT_MS (must stay under the Cloud Run
# request timeout of 600s).
JITSI_ACTIVATOR_URL=
VM_STOP_MAX_WAIT_MS=240000
VM_STOP_POLL_INTERVAL_MS=15000
