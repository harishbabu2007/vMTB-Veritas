# opus-transcriber-proxy configuration
# Copy to .env and fill in values. Never commit real secrets.

# --- Server ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# --- STT backend ---
# provider: "self-hosted" (WhisperLive-compatible service) or "dummy" (local dev only)
PROVIDER=self-hosted
# WebSocket URL of the self-hosted STT service (required when PROVIDER=self-hosted)
STT_WS_URL=ws://stt-service:9090/client/ws/speech
# PCM sample rate forwarded to the STT backend (Hz)
STT_SAMPLE_RATE=16000
# accumulate this many ms of PCM before forwarding to STT
STT_CHUNK_MS=60
# Set to true when the STT service is a Cloud Run service deployed with
# --no-allow-unauthenticated: the proxy then attaches a Google ID token to
# every STT WebSocket connection (uses the runtime service account).
STT_USE_ID_TOKEN=false
# Max wait (ms) for the STT end-of-stream flush when a meeting ends, so the
# trailing seconds of the transcript are committed before meeting.completed.
STT_DRAIN_TIMEOUT_MS=10000
# Authenticated GET /ready pings while a session is open, to keep the
# scale-to-zero STT Cloud Run instance warm. 0 disables (local/dummy).
STT_WARM_INTERVAL_MS=120000

# --- Supabase persistence ---
# persistence: "supabase" (default) or "none" (local runs without a database)
PERSISTENCE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Pub/Sub meeting.completed events (optional; publishing is a no-op when unset) ---
GCP_PROJECT_ID=
PUBSUB_TOPIC=
# Set to something like localhost:8085 when running against the Pub/Sub emulator
PUBSUB_EMULATOR_HOST=

# --- Session identity guard ---
MAX_SESSION_ID_LENGTH=128